# Copy to .env and change the values. .env is git-ignored.
#
# Note: the app does NOT read this file by itself. docker-compose loads it (env_file),
# and for local runs you set variables in your shell. With no DATABASE_URL set, local
# runs use a SQLite file (verification_shield.db).

# Database (docker-compose builds DATABASE_URL for the container from these)
POSTGRES_USER=verification
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
POSTGRES_DB=verification_db
# For running the app on your machine against a local Postgres:
# DATABASE_URL=postgresql://verification:<password>@localhost:5432/verification_db

# API
# Comma-separated frontend origins allowed by CORS (includes localhost and 127.0.0.1 Vite origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Behind a reverse proxy / load balancer (Render, Railway, nginx) set this so the rate
# limiter sees each visitor's real IP instead of the proxy's. uvicorn reads it directly.
# Only trust "*" when the app is reachable ONLY through the proxy (true on Render).
# FORWARDED_ALLOW_IPS=*
# Request rate limit (DEMO_MODE=1 defaults to 100/minute when unset)
RATE_LIMIT=10/minute
# Optional full path to tesseract.exe when it is not on PATH
TESSERACT_CMD=
LOG_LEVEL=INFO

# Community reporting is disabled until a deployment-only secret is configured.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INDICATOR_PEPPER=
INDICATOR_KEY_VERSION=1
# On rotation, retain old keys temporarily as comma-separated version:secret pairs.
INDICATOR_PEPPER_PREVIOUS=
# Optional SMTP used only for verified domain-dispute links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.invalid
PUBLIC_BASE_URL=http://localhost:8000

# Demo mode (never enable in production): .example fixture domains pass the domain
# check with a "[DEMO FIXTURE — not a live DNS result]" label.
DEMO_MODE=0
DEMO_FIXTURE_DOMAINS=

# Local SQLite company master built by scripts/load_mca_master.py. For demos, load
# fixtures/demo/synthetic_mca_master.csv with --synthetic; a SYNTHETIC snapshot is
# used only when DEMO_MODE=1.
# Relative paths resolve against the process working directory (/app in Docker). In
# Docker, mount a volume and use an absolute path, e.g. MCA_DB_PATH=/app/data/mca_master.sqlite3.
MCA_DB_PATH=data/mca_master.sqlite3

# Optional: personal data.gov.in API key (My Account on data.gov.in). When set (and
# DEMO_MODE is off) a CIN missing from the local snapshot gets one live lookup against
# the "RoC-wise Company Master Data" resource, 2.5 s timeout, fail-closed. Never commit it.
# The public sample key is deliberately not supported. data.gov.in may block cloud IPs.
DATA_GOV_IN_API_KEY=
# Optional tuning (all bounded 0.5-10 s; https-only host override if the API ever moves):
# DATA_GOV_IN_BASE_URL=https://api.data.gov.in
# MCA_LIVE_LOOKUP_TIMEOUT=2.5
# INFRA_AGE_TIMEOUT=3

# Optional: 1 adds an informational "earliest Internet Archive copy" sentence to a domain check
# whose age could not be determined (one public lookup, 3 s timeout, never changes the score).
INFRA_AGE_LOOKUPS=0

# Optional: 1 adds an informational sentence when the sender's own domain serves a careers-like page
# (https only, public addresses only, no redirects, 3 s timeout, never changes the score).
CAREERS_PAGE_LOOKUPS=0

# Optional: 1 lets people tick a consent box to have up to 3 links checked with Google Web Risk and by visiting
# them from this server (see docs/PRIVACY_DESIGN.md). Web Risk needs a Google Cloud API key (free up to
# 100,000 lookups a month at the time of writing); without a key only the redirect and certificate checks run.
LINK_LOOKUPS=0
WEB_RISK_API_KEY=
LINK_LOOKUP_TIMEOUT=4

# Currently NOT used by any code (no registry or paid WHOIS integration exists).
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
ENVIRONMENT=development
